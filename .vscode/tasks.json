      "problemMatcher": []
    },
    {
      "label": "Grupo 14: render all (high)",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "${workspaceFolder}\\scripts\\render_all.py",
        "--quality",
        "h"
      ],
      "options": {
        "env": {
          "PATH": "${env:LOCALAPPDATA}\\Programs\\MiKTeX\\miktex\\bin\\x64;${env:PATH}"
        }
      },
      "problemMatcher": []
